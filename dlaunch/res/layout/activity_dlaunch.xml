<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Background Wallpaper Layer (System or Custom Image) -->
    <ImageView
        android:id="@+id/wallpaper_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- 2. Dimming Overlay for Text & Card Readability -->
    <View
        android:id="@+id/wallpaper_dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73000000"
        android:visibility="gone" />

    <!-- 3. Dynamic Ambient Artwork Backdrop (Softened 48x27 upscale) -->
    <ImageView
        android:id="@+id/hero_art_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:contentDescription="@null" />

    <!-- 4. Ambient Gradient Scrim (Keeps content crystal clear) -->
    <View
        android:id="@+id/hero_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim"
        android:alpha="0.88" />

    <!-- 5. Dynamic Ambient Glow Tint View -->
    <View
        android:id="@+id/ambient_glow_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- 6. Main Content Layout -->
    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_screen"
        android:paddingLeft="48dp"
        android:paddingRight="48dp"
        android:paddingTop="26dp"
        android:paddingBottom="20dp"
        android:clipToPadding="true"
        android:clipChildren="true">

        <!-- TOP HEADER BAR -->
        <LinearLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <!-- Left Container: Brand Pill + Greeting + Clock + Date (expands to fill available width) -->
            <LinearLayout
                android:id="@+id/header_left_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- Row 1: Brand Emblem + Time Greeting -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Brand Capsule (Non-overlapping, left-aligned) -->
                    <LinearLayout
                        android:id="@+id/brand_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_pill_normal"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp">

                        <TextView
                            android:id="@+id/brand_letter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="D"
                            android:textColor="@color/card_border_focused"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/brand_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:text="Launch"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="normal" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="•"
                        android:textColor="#5594A3B8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/greeting_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GOOD EVENING"
                        android:textColor="#A0CBD5E1"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.20"
                        android:textAllCaps="true"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Row 2: Clock + AM/PM + Divider + Date -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="@color/text_primary"
                        android:textSize="40sp"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.03" />

                    <TextClock
                        android:id="@+id/ampm_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="5dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:id="@+id/clock_divider"
                        android:layout_width="1.5dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="7dp"
                        android:background="#33FFFFFF" />

                    <TextView
                        android:id="@+id/date_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.02"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Container: Quick Action Buttons (Inputs, Wi-Fi, Settings) -->
            <LinearLayout
                android:id="@+id/header_buttons_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- 1. TV Inputs Switcher -->
                <LinearLayout
                    android:id="@+id/btn_inputs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_pill_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:id="@+id/ic_inputs_view"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_inputs" />

                    <TextView
                        android:id="@+id/tv_inputs_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_inputs"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. TV Wi-Fi Network Button -->
                <LinearLayout
                    android:id="@+id/btn_wifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_pill_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:id="@+id/ic_wifi_view"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_wifi" />

                    <TextView
                        android:id="@+id/tv_wifi_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_wifi"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 3. TV Settings -->
                <LinearLayout
                    android:id="@+id/btn_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_pill_selector"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:id="@+id/ic_settings_view"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_settings" />

                    <TextView
                        android:id="@+id/tv_settings_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_settings"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- SCROLLABLE BODY -->
        <ScrollView
            android:id="@+id/main_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="20dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="true"
                android:clipToPadding="true">

                <!-- CINEMATIC HERO SHOWCASE (Streamlined & Proportional) -->
                <LinearLayout
                    android:id="@+id/hero_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <!-- Hero Glass Frame for Focused Icon -->
                    <FrameLayout
                        android:id="@+id/hero_icon_frame"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_hero_icon_frame"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/hero_icon_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <!-- App Title & Hint -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/hero_title_view"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Select an app"
                                android:textColor="#FFFFFFFF"
                                android:textSize="26sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="-0.01"
                                android:includeFontPadding="false"
                                android:singleLine="true" />

                            <TextView
                                android:id="@+id/hero_badge_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/bg_hero_badge"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp"
                                android:text="✦ FAVORITE"
                                android:textColor="#00E5FF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/hero_subtitle_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="✦ Press OK to Launch  •  Long-Press for Options"
                            android:textColor="#8594A3B8"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif"
                            android:letterSpacing="0.03" />
                    </LinearLayout>
                </LinearLayout>

                <!-- FLOATING GLASS DOCK CAPSULE (FAVORITES) -->
                <LinearLayout
                    android:id="@+id/section_favorites_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Floating Glass Capsule Dock (Borderless) -->
                    <HorizontalScrollView
                        android:id="@+id/favorites_scroll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/bg_dock_capsule"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:scrollbars="none"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:id="@+id/favorites_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- ALL APPS SECTION -->
                <LinearLayout
                    android:id="@+id/section_all_apps_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <TextView
                        android:id="@+id/label_all_apps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/section_all_apps"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <!-- Dynamic Grid container where rows are injected programmatically -->
                    <LinearLayout
                        android:id="@+id/all_apps_grid_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false" />

                    <!-- Empty State Message -->
                    <TextView
                        android:id="@+id/tv_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:gravity="center"
                        android:text="@string/msg_no_apps"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Extra bottom breathing space -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- 7. Dynamic Floating Glass Focus Highlight (Glides over focused item) -->
    <com.dewzone.dlaunch.GlassHighlightView
        android:id="@+id/glass_highlight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="false"
        android:clickable="false"
        android:visibility="gone" />

    <!-- 8. CALM AMBIENT SCREENSAVER OVERLAY -->
    <RelativeLayout
        android:id="@+id/screensaver_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:alpha="0">

        <!-- Centered Tranquil Ambient Time, Date & Breath -->
        <LinearLayout
            android:id="@+id/screensaver_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/screensaver_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textColor="@color/text_primary"
                android:textSize="76sp"
                android:fontFamily="sans-serif-thin"
                android:shadowColor="#8000E5FF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="28" />

            <TextView
                android:id="@+id/screensaver_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/screensaver_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Calm Ambient Mode"
                android:textColor="@color/text_accent"
                android:textSize="13sp"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- Subtle Wake Hint at Bottom -->
        <TextView
            android:id="@+id/screensaver_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="36dp"
            android:text="Press any remote button to wake"
            android:textColor="#5594A3B8"
            android:textSize="12sp"
            android:letterSpacing="0.08" />

    </RelativeLayout>

</FrameLayout>
