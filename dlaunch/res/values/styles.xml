<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Leanback-ready zero-decor Fullscreen Theme -->
    <style name="Theme.DLaunch" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <!-- Translucent Glass Dialog Theme -->
    <style name="Theme.DLaunch.Dialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.75</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>

